# Bookly API base URL, including /api/v1.
# Live API (Render free plan; the first request after a quiet period takes ~30-60 s):
VITE_API_BASE_URL=https://bookly-api-zasc.onrender.com/api/v1
# Local backend (php artisan serve in bookly_backend_v2):
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# The site's public address, no trailing slash (e.g. https://bookly.vercel.app). Used at build time for
# sitemap.xml, robots.txt and absolute share links; leave empty locally.
VITE_SITE_URL=

# Error reporting (optional; off when empty). Sentry project DSN for the browser app.
VITE_SENTRY_DSN=

# Cloudflare Turnstile site key (bot check on sign-up, sign-in and code emails). Empty = off.
# Set together with TURNSTILE_SECRET_KEY on the API. Cloudflare's test key 1x00000000000000000000AA always passes.
VITE_TURNSTILE_SITE_KEY=
# Optional label for Sentry (defaults to the build mode, e.g. "production").
VITE_SENTRY_ENVIRONMENT=
# Build-time only, set in Vercel (never in a VITE_ variable): uploads source maps to Sentry.
# SENTRY_AUTH_TOKEN=  SENTRY_ORG=  SENTRY_PROJECT=
# Vercel function api/sentry-alert (Sentry → Telegram): SENTRY_WEBHOOK_SECRET, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID.

# Sign in with Google / Facebook. Each button turns on once its id is set (the API needs GOOGLE_CLIENT_ID /
# FACEBOOK_CLIENT_ID + FACEBOOK_CLIENT_SECRET too).
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
