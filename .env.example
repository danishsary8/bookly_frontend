# Bookly API base URL, including /api/v1.
# Live API (Render free plan; the first request after a quiet period takes ~30-60 s):
VITE_API_BASE_URL=https://bookly-api-zasc.onrender.com/api/v1
# Local backend (php artisan serve in bookly_backend_v2):
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# The site's public address, no trailing slash (e.g. https://bookly.vercel.app). Used at build time for
# sitemap.xml, robots.txt and absolute share links; leave empty locally.
VITE_SITE_URL=
